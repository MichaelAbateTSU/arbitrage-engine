ENVIRONMENT=development
DATA_MODE=demo
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
KALSHI_EXECUTION_ENABLED=false
POLYMARKET_EXECUTION_ENABLED=false
GLOBAL_KILL_SWITCH=true
DATABASE_URL=postgresql+asyncpg://arb:local-development-only@db:5432/arb
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000,http://127.0.0.1:5173
PUBLIC_READ_ENABLED=false
# Run python scripts/generate_admin.py and put only the hash below.
# Docker Compose's $$ escapes literal $ in Argon2 hashes; .env hashes use single quotes.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Authenticated market DATA and GET-only balance evidence, never order execution.
KALSHI_ENVIRONMENT=production
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY=
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=
OPERATOR_COUNTRY=US
OPERATOR_REGION=GA
VALIDATION_INTERVAL_SECONDS=10
DISCOVERY_INTERVAL_SECONDS=300
# Opt-in read-only BTC 15-minute research. This does not approve contracts or enable orders.
BTC_15M_ENABLED=false
BTC_DISCOVERY_INTERVAL_SECONDS=15
MAX_MONITORED_MARKETS=80
REQUEST_RATE=5
BOOK_RETENTION_DAYS=7
HISTORY_RETENTION_DAYS=180
